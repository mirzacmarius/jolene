{
  "$schema": "https://v2-11-9.turborepo.dev/schema.json",
  "agentGuidance": false,
  "globalDependencies": ["**/.env"],
  "globalPassThroughEnv": ["SITE_PASSWORD"],
  "ui": "stream",
  "tasks": {
    "topo": {
      "dependsOn": ["^topo"]
    },
    "build": {
      "env": [
        "NEXT_PUBLIC_CONVEX_URL",
        "V0_CALLBACK_URL",
        "VERCEL_ENV",
        "VERCEL_PROJECT_PRODUCTION_URL"
      ],
      "inputs": ["$TURBO_DEFAULT$", ".env"],
      "dependsOn": ["^build"],
      "outputs": [".next/**", "!.next/cache/**", "next-env.d.ts"]
    },
    "start": {
      "cache": false
    },
    "clean": {
      "cache": false
    },
    "dev": {
      "inputs": ["$TURBO_DEFAULT$", ".env"],
      "persistent": true,
      "cache": false
    },
    "lint": {
      "dependsOn": ["^topo"]
    },
    "typecheck": {
      "dependsOn": ["^topo"],
      "outputs": []
    }
  }
}
